{
  "name": "Exchange",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "value": {
      "type": "number",
      "default": 0
    },
    "item": {
      "type": "string",
      "description": "Item exchanged"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled"
      ],
      "default": "completed"
    },
    "note": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "seller_id",
    "value",
    "status"
  ]
}
