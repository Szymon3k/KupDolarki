{
  "name": "LegitCheck",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "fake",
        "inconclusive"
      ],
      "default": "verified"
    },
    "note": {
      "type": "string"
    },
    "added_by": {
      "type": "string",
      "description": "Member id of person who added this record"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "seller_id",
    "status"
  ]
}
