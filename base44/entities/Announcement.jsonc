{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "important",
        "urgent",
        "system"
      ],
      "default": "info"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_by": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "body",
    "type"
  ]
}
