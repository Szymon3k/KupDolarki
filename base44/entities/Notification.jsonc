{
  "name": "Notification",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string",
      "description": "Recipient member id"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string",
      "description": "Optional internal path"
    }
  },
  "required": [
    "member_id",
    "title",
    "body"
  ]
}
